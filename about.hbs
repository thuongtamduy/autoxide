<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Autoxide third-party licenses</title>
<style>body{font-family:system-ui,sans-serif;max-width:60rem;margin:2rem auto;padding:0 1rem}pre{white-space:pre-wrap;background:#f4f4f4;padding:1rem}li{margin:.2rem 0}</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>Autoxide itself is licensed under MIT OR Apache-2.0. The Rust crates below are compiled into the binary; each is used under the license named here.</p>
<h2>Summary</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licenses</h2>
{{#each licenses}}
<section id="{{id}}">
<h3>{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
