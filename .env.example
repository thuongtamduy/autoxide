# Autoxide configuration.
#
# Copy this file to `.env` and uncomment the lines you want to change. Real
# environment variables take precedence over `.env`. Never commit `.env`.
#
# This file is generated from the settings declared in the code: run
# `autoxide config --env-example`. A test fails when it is out of date.

# Database to use. SQLite: `sqlite://path/to/file.sqlite` (the file and its
# directory are created when missing). PostgreSQL 16 or newer:
# `postgres://user:password@host:5432/database`.
# Default: sqlite://data/autoxide.sqlite
#DATABASE_URL=sqlite://data/autoxide.sqlite

# PostgreSQL only: a read replica to send read queries to. When unset, reads use
# DATABASE_URL.
# Optional.
#DATABASE_READ_URL=postgres://user:password@replica:5432/database

# Maximum number of connections used for writes. SQLite always uses exactly one,
# because SQLite allows a single writer at a time.
# Default: 10
#AUTOXIDE_DATABASE_WRITE_CONNECTIONS=10

# Maximum number of connections used for read queries.
# Default: 10
#AUTOXIDE_DATABASE_READ_CONNECTIONS=10

# How long a query waits for a free connection, or for a lock held by another
# writer, before failing.
# Default: 10
#AUTOXIDE_DATABASE_WAIT_SECONDS=10

# Address and port the HTTP server listens on. Use `0.0.0.0:8080` to accept
# connections from other machines (for example inside Docker).
# Default: 127.0.0.1:8080
#AUTOXIDE_HTTP_ADDRESS=127.0.0.1:8080

# Maximum time to handle one request. A request that takes longer is answered
# with 503.
# Default: 30
#AUTOXIDE_HTTP_REQUEST_TIMEOUT_SECONDS=30

# Maximum size of a request body, in bytes. Larger requests are answered with
# 413.
# Default: 1048576
#AUTOXIDE_HTTP_BODY_LIMIT_BYTES=1048576

# Web origins allowed to call the API from a browser, separated by commas, or
# `*` for any origin. When unset, browsers on other origins are refused.
# Optional.
#AUTOXIDE_HTTP_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# On shutdown, how long to wait for requests in progress to finish before
# closing them.
# Default: 30
#AUTOXIDE_HTTP_SHUTDOWN_SECONDS=30

# Serve an interactive API reference at `/api/docs` (`true` or `false`). The
# page loads its viewer script from a public CDN. The OpenAPI document itself is
# always served at `/api/v1/openapi.json`.
# Default: false
#AUTOXIDE_HTTP_API_DOCS=false

# Serve Prometheus metrics at `/metrics` (`true` or `false`). The endpoint has
# no authentication: enable it only where the port is not reachable from the
# internet.
# Default: false
#AUTOXIDE_HTTP_METRICS=false

# Requests one client address may make per minute, on average; more are answered
# with 429 and a `Retry-After` header. `0` turns rate limiting off. Health
# checks are not counted. Counted per server process.
# Default: 600
#AUTOXIDE_HTTP_RATE_LIMIT_PER_MINUTE=600

# Requests one client address may make at once before the per-minute rate
# applies.
# Default: 60
#AUTOXIDE_HTTP_RATE_LIMIT_BURST=60

# Behind a reverse proxy, the header in which the proxy passes the client's
# address (for `X-Forwarded-For`, the last address is used). Set it only when
# every request goes through that proxy: clients can forge the header otherwise.
# When unset, the address of the connection is used.
# Optional.
#AUTOXIDE_HTTP_CLIENT_IP_HEADER=X-Forwarded-For

# Least severe level to log: `trace`, `debug`, `info`, `warn` or `error`.
# Default: info
#AUTOXIDE_LOG_LEVEL=info

# Log format: `text` for people reading a terminal, `json` (one object per line)
# for log collectors.
# Default: text
#AUTOXIDE_LOG_FORMAT=text

# Send traces to this OpenTelemetry collector over OTLP/HTTP, for example
# `http://localhost:4318`. When unset, no traces are exported. Only `http://` is
# supported: run a collector next to the server and let it forward over TLS.
# Optional.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Name under which this service appears in traces.
# Default: autoxide
#OTEL_SERVICE_NAME=autoxide

# Secret key that signs access tokens: at least 32 characters, random. Generate
# one with `openssl rand -base64 48`. Every server of one deployment must use
# the same value. When unset, a random key is generated at startup: access
# tokens then stop working after a restart (clients refresh them), and several
# servers cannot share them.
# Optional.
#AUTOXIDE_AUTH_TOKEN_SECRET=change-me-to-a-long-random-value-from-openssl-rand

# How long an access token stays valid, in seconds (60 to 86400). Short is
# safer: a stolen token works only until it expires.
# Default: 900
#AUTOXIDE_AUTH_ACCESS_TOKEN_SECONDS=900

# How long a refresh token stays valid, in days (1 to 365). Each refresh issues
# a new one with a fresh lifetime; a session left unused this long must sign in
# again.
# Default: 30
#AUTOXIDE_AUTH_REFRESH_TOKEN_DAYS=30

# Failed sign-ins allowed for one email within AUTOXIDE_AUTH_LOGIN_LOCK_MINUTES
# (1 to 100). One more locks sign-in for that email for
# AUTOXIDE_AUTH_LOGIN_LOCK_MINUTES, even with the right password. Shared by
# every server, since it is counted in the database.
# Default: 5
#AUTOXIDE_AUTH_LOGIN_MAX_FAILURES=5

# How long failed sign-ins are remembered, and how long sign-in stays locked
# after too many (1 to 1440).
# Default: 15
#AUTOXIDE_AUTH_LOGIN_LOCK_MINUTES=15

# Let anyone create an account with `POST /api/v1/auth/register` (`true` or
# `false`). New accounts get no role. When `false`, only users with the
# `auth.users.manage` permission create accounts.
# Default: false
#AUTOXIDE_AUTH_SELF_REGISTRATION=false

# Name shown next to the account in authenticator apps (Google Authenticator,
# 1Password…) when a user turns on two-step sign-in. Usually your product name;
# no `:`.
# Default: Autoxide
#AUTOXIDE_AUTH_TOTP_ISSUER=Autoxide
