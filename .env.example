# Autoxide configuration.
#
# Copy this file to `.env` and uncomment the lines you want to change. Real
# environment variables take precedence over `.env`. Never commit `.env`.
#
# This file is generated from the settings declared in the code: run
# `autoxide config --env-example`. A test fails when it is out of date.

# Database to use. SQLite: `sqlite://path/to/file.sqlite` (the file and its
# directory are created when missing). PostgreSQL 16 or newer:
# `postgres://user:password@host:5432/database`.
# Default: sqlite://data/autoxide.sqlite
#DATABASE_URL=sqlite://data/autoxide.sqlite

# PostgreSQL only: a read replica to send read queries to. When unset, reads use
# DATABASE_URL.
# Optional.
#DATABASE_READ_URL=postgres://user:password@replica:5432/database

# Maximum number of connections used for writes. SQLite always uses exactly one,
# because SQLite allows a single writer at a time.
# Default: 10
#AUTOXIDE_DATABASE_WRITE_CONNECTIONS=10

# Maximum number of connections used for read queries.
# Default: 10
#AUTOXIDE_DATABASE_READ_CONNECTIONS=10

# How long a query waits for a free connection, or for a lock held by another
# writer, before failing.
# Default: 10
#AUTOXIDE_DATABASE_WAIT_SECONDS=10

# Address and port the HTTP server listens on. Use `0.0.0.0:8080` to accept
# connections from other machines (for example inside Docker).
# Default: 127.0.0.1:8080
#AUTOXIDE_HTTP_ADDRESS=127.0.0.1:8080

# Maximum time to handle one request. A request that takes longer is answered
# with 503.
# Default: 30
#AUTOXIDE_HTTP_REQUEST_TIMEOUT_SECONDS=30

# Maximum size of a request body, in bytes. Larger requests are answered with
# 413.
# Default: 1048576
#AUTOXIDE_HTTP_BODY_LIMIT_BYTES=1048576

# Web origins allowed to call the API from a browser, separated by commas, or
# `*` for any origin. When unset, browsers on other origins are refused.
# Optional.
#AUTOXIDE_HTTP_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# On shutdown, how long to wait for requests in progress to finish before
# closing them.
# Default: 30
#AUTOXIDE_HTTP_SHUTDOWN_SECONDS=30

# On shutdown, how long to keep handling requests while `/health/ready` answers
# 503, before the server stops accepting connections. Load balancers then stop
# sending new requests in time, so a rolling deploy drops none. Set it longer
# than your load balancer needs to mark an instance down (health check interval
# times failure threshold, for example `15`). `0` stops accepting connections at
# once, for a single instance with no load balancer.
# AUTOXIDE_HTTP_SHUTDOWN_SECONDS starts counting after this.
# Default: 0
#AUTOXIDE_HTTP_DRAIN_SECONDS=0

# Serve an interactive API reference at `/api/docs` (`true` or `false`). The
# page loads its viewer script from a public CDN. The OpenAPI document itself is
# always served at `/api/v1/openapi.json`.
# Default: false
#AUTOXIDE_HTTP_API_DOCS=false

# Serve Prometheus metrics at `/metrics` (`true` or `false`). The endpoint has
# no authentication: enable it only where the port is not reachable from the
# internet.
# Default: false
#AUTOXIDE_HTTP_METRICS=false

# Requests one client address may make per minute, on average; more are answered
# with 429 and a `Retry-After` header. `0` turns rate limiting off. Health
# checks are not counted. Counted per server process.
# Default: 600
#AUTOXIDE_HTTP_RATE_LIMIT_PER_MINUTE=600

# Requests one client address may make at once before the per-minute rate
# applies.
# Default: 60
#AUTOXIDE_HTTP_RATE_LIMIT_BURST=60

# With AUTOXIDE_HTTP_CLIENT_IP_HEADER: how many of your own proxies a request
# passes before the API (1 to 10). Each adds an address at the end of the
# header; the client's is this many from the end. `1` for one reverse proxy; `2`
# for a CDN in front of a website server (such as Next.js) that calls the API
# and forwards the header. A wrong count makes every visitor look like one
# client, or lets clients choose their address.
# Default: 1
#AUTOXIDE_HTTP_TRUSTED_PROXY_COUNT=1

# Requests one API key may make per minute, on average (REST and MCP), on top of
# the limit per client address; more are answered with 429 and a `Retry-After`
# header. AI agents often retry in loops: this keeps one key from crowding out
# the others. `0` turns it off. Counted per server process.
# Default: 120
#AUTOXIDE_HTTP_RATE_LIMIT_API_KEY_PER_MINUTE=120

# Requests one API key may make at once before the per-minute rate applies.
# Default: 30
#AUTOXIDE_HTTP_RATE_LIMIT_API_KEY_BURST=30

# Behind a reverse proxy, the header in which the proxy passes the client's
# address, usually `X-Forwarded-For`. Set it only when every request goes
# through your proxies: clients can forge the header otherwise. When unset, the
# address of the connection is used.
# Optional.
#AUTOXIDE_HTTP_CLIENT_IP_HEADER=X-Forwarded-For

# With AUTOXIDE_HTTP_CLIENT_IP_HEADER: the addresses of your own proxies, as a
# comma-separated list of IP addresses and ranges (`10.0.0.0/8, 2001:db8::/32,
# 192.0.2.7`). When set, it replaces AUTOXIDE_HTTP_TRUSTED_PROXY_COUNT: the
# header is read only when the connection comes from one of these addresses, and
# the client is the last address in the header that is not one of them. Safer
# than a count when clients could reach one of your proxies directly, or take
# different paths to the API.
# Optional.
#AUTOXIDE_HTTP_TRUSTED_PROXIES=10.0.0.0/8, 192.0.2.7

# Least severe level to log: `trace`, `debug`, `info`, `warn` or `error`.
# Default: info
#AUTOXIDE_LOG_LEVEL=info

# Log format: `text` for people reading a terminal, `json` (one object per line)
# for log collectors.
# Default: text
#AUTOXIDE_LOG_FORMAT=text

# Send traces to this OpenTelemetry collector over OTLP/HTTP, for example
# `http://localhost:4318`. When unset, no traces are exported. Only `http://` is
# supported: run a collector next to the server and let it forward over TLS.
# Optional.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Name under which this service appears in traces.
# Default: autoxide
#OTEL_SERVICE_NAME=autoxide

# What `autoxide serve` runs: `all` (the API and the background work), `api`
# (only the API) or `worker` (only background work — jobs, scheduled jobs, event
# delivery — plus the health checks). Split them to scale the API and the
# workers separately; run at least one process with `all` or `worker`, or
# background work never happens.
# Default: all
#AUTOXIDE_PROCESS_ROLE=all

# Jobs one worker process runs at the same time, per module (1 to 256).
# Default: 4
#AUTOXIDE_JOBS_CONCURRENCY=4

# `single` (one customer: the default, nothing else to set) or `multi` (many
# customers, told apart by domain, credentials or the `Autoxide-Tenant` header).
# Default: single
#AUTOXIDE_TENANCY_MODE=single

# Seconds a looked-up tenant is cached (1 to 3600) in `multi` mode. Suspending a
# tenant takes effect on other servers within this time.
# Default: 10
#AUTOXIDE_TENANCY_CACHE_SECONDS=10

# Most tenant databases (placements) kept open at once (1 to 10000); the least
# used one is closed when more are needed.
# Default: 32
#AUTOXIDE_TENANCY_MAX_OPEN_DATABASES=32

# Write connections of each tenant database other than DATABASE_URL (1 to 100).
# SQLite always uses one.
# Default: 2
#AUTOXIDE_TENANCY_WRITE_CONNECTIONS=2

# Read connections of each tenant database other than DATABASE_URL (1 to 100).
# Default: 4
#AUTOXIDE_TENANCY_READ_CONNECTIONS=4

# Directory of the SQLite file of each tenant with its own database. Default:
# `tenants/` next to the file of DATABASE_URL.
# Optional.
#AUTOXIDE_TENANCY_SQLITE_DIR=data/tenants

# Placements whose jobs and events this server runs: `all`, or placement names
# separated by commas.
# Default: all
#AUTOXIDE_WORKER_PLACEMENTS=all

# Key that signs short-lived tokens of every module (form tokens, anti-spam
# challenges): at least 32 characters, random. Generate one with `openssl rand
# -base64 48`. When unset, one is generated once and kept in the database, so
# every server sharing the database uses it. Changing it invalidates tokens
# already handed out (they live minutes, not days).
# Optional.
#AUTOXIDE_SECRET_KEY=change-me-to-a-long-random-value-from-openssl-rand

# Old values of AUTOXIDE_SECRET_KEY, separated by commas, while rotating the
# key: secrets stored encrypted with an old key stay readable until `autoxide
# secrets reseal` encrypts them again with the current one. Remove them after
# that.
# Optional.
#AUTOXIDE_SECRET_KEY_PREVIOUS=

# Address at which the internet reaches this API, without a trailing slash, e.g.
# `https://api.example.com`. Needed for absolute links back to the API, such as
# the one-click unsubscribe link in newsletters; features that need it say so
# when it is unset.
# Optional.
#AUTOXIDE_HTTP_PUBLIC_URL=https://api.example.com

# Most interface flags one user may keep (dismissed hints, last seen "what's
# new" version…), 1 to 100000. Past it, new flags are refused until the user
# deletes some.
# Default: 500
#AUTOXIDE_USER_FLAGS_MAX=500

# Proof that a person sends a public form: `none` (default; the other layers —
# trap field, signed form token, rate limits — still apply) or `altcha` (a
# proof-of-work the browser solves with the ALTCHA widget, self-hosted, no
# third-party account).
# Default: none
#AUTOXIDE_ANTISPAM_CHALLENGE=none

# With AUTOXIDE_ANTISPAM_CHALLENGE=altcha: rounds of SHA-256 per guess (10 to
# 100000); the browser makes 32 to 64 guesses. Higher costs bots more and slow
# phones too: aim for under a second on a mid-range phone (not measured yet;
# adjust after trying).
# Default: 500
#AUTOXIDE_ANTISPAM_ALTCHA_COST=500

# A public form sent sooner than this many seconds after its form token was
# issued is held for review (0 to 600). People take longer than bots.
# Default: 3
#AUTOXIDE_ANTISPAM_MIN_FILL_SECONDS=3

# How long a form token stays valid, in minutes (1 to 1440). The website fetches
# a token when it shows the form, never into cached HTML.
# Default: 120
#AUTOXIDE_ANTISPAM_TOKEN_MAX_AGE_MINUTES=120

# What to do with a submission when a challenge provider or content classifier
# cannot be reached: `quarantine` (accept it and hold it for review) or `reject`
# (answer 503).
# Default: quarantine
#AUTOXIDE_ANTISPAM_FAIL_MODE=quarantine

# SMTP server that sends mail: `smtps://user:password@host:465` (TLS), or
# `smtp://user:password@host:587?tls=required` (STARTTLS). Percent-encode
# special characters in the user and password. When unset, mail is written as
# `.eml` files to AUTOXIDE_MAIL_FILE_DIR instead of being sent — fine for
# development, not for production.
# Optional.
#AUTOXIDE_MAIL_SMTP_URL=smtps://user:password@smtp.example.com:465

# Sender of every mail, as `Name <address>` or `address`. Use an address your
# SMTP server may send from.
# Default: Autoxide <noreply@localhost>
#AUTOXIDE_MAIL_FROM=Autoxide <noreply@localhost>

# Directory where mail is written when AUTOXIDE_MAIL_SMTP_URL is unset; created
# when missing.
# Default: data/mail
#AUTOXIDE_MAIL_FILE_DIR=data/mail

# Which AI provider generates text: `none` (AI features are off), `anthropic`
# (Claude, Messages API) or `openai` (the OpenAI Chat Completions format —
# OpenAI itself, Google Gemini through its OpenAI-compatible endpoint, Ollama,
# vLLM, LM Studio, OpenRouter… chosen with AUTOXIDE_AI_BASE_URL).
# Default: none
#AUTOXIDE_AI_PROVIDER=none

# API key of the AI provider. Required for `anthropic`; for `openai`, leave it
# empty only for a local server that needs none (Ollama).
# Optional.
#AUTOXIDE_AI_API_KEY=

# Base address of the provider's API. Defaults: `https://api.anthropic.com` for
# `anthropic`, `https://api.openai.com/v1` for `openai`. Examples for `openai`:
# `https://generativelanguage.googleapis.com/v1beta/openai` (Gemini),
# `http://localhost:11434/v1` (Ollama).
# Optional.
#AUTOXIDE_AI_BASE_URL=http://localhost:11434/v1

# Model that generates text. Default for `anthropic`: `claude-opus-5-5`.
# Required for `openai` (names differ between services and change often).
# Optional.
#AUTOXIDE_AI_MODEL=claude-opus-5-5

# Whether the model reads images (needed for alt text suggestions): `true` or
# `false`. Set `false` for a text-only local model.
# Default: true
#AUTOXIDE_AI_IMAGES=true

# Longest wait for one answer of the AI provider, 1 to 3600 seconds.
# Default: 600
#AUTOXIDE_AI_TIMEOUT_SECONDS=600

# Tokens (input plus output, text and embeddings together) the server may use
# per UTC day; past it, AI features answer 429 `ai.quota_exceeded` until the
# next day. Counted in the database, shared by every server process; concurrent
# calls may go slightly over. `0` means no limit.
# Default: 2000000
#AUTOXIDE_AI_DAILY_TOKEN_LIMIT=2000000

# Days the daily token counts are kept, 1 to 3650.
# Default: 90
#AUTOXIDE_AI_USAGE_RETENTION_DAYS=90

# For `anthropic`: when Claude's safety classifier declines a request, let
# Anthropic rerun it on another model in the same call (beta
# `server-side-fallback`). `true` or `false`; set `false` for models that do not
# support it (Claude Haiku).
# Default: true
#AUTOXIDE_AI_ANTHROPIC_FALLBACK=true

# For `openai`: `strict` asks the server to follow the JSON Schema of each
# answer (`response_format` `json_schema`); `json_object` only asks for JSON,
# for servers that do not take a schema. The server checks every answer either
# way.
# Default: strict
#AUTOXIDE_AI_OPENAI_SCHEMA_MODE=strict

# For `openai`: send `reasoning_effort` (`true` or `false`). Only reasoning
# models accept it; others answer 400.
# Default: false
#AUTOXIDE_AI_OPENAI_SEND_EFFORT=false

# For `openai`: the request field that caps the answer length,
# `max_completion_tokens` (OpenAI) or `max_tokens` (older compatible servers).
# Default: max_completion_tokens
#AUTOXIDE_AI_OPENAI_MAX_TOKENS_PARAM=max_completion_tokens

# Which service computes embeddings for search by meaning: `none` (off; search
# matches words only) or `openai` (the `/embeddings` format of OpenAI, also
# served by Gemini, Ollama, vLLM and Voyage AI). Independent of
# AUTOXIDE_AI_PROVIDER.
# Default: none
#AUTOXIDE_EMBEDDING_PROVIDER=none

# Base address of the embeddings API.
# Default: https://api.openai.com/v1
#AUTOXIDE_EMBEDDING_BASE_URL=https://api.openai.com/v1

# API key of the embeddings service, if it needs one.
# Optional.
#AUTOXIDE_EMBEDDING_API_KEY=

# Embedding model; required when embeddings are on. Prefer a multilingual model
# of about 1024 dimensions (for example `bge-m3` on Ollama).
# Optional.
#AUTOXIDE_EMBEDDING_MODEL=bge-m3

# Length of the vectors the model returns, 1 to 8192; required when embeddings
# are on. Changing the model or this value rebuilds the search index.
# Optional.
#AUTOXIDE_EMBEDDING_DIMENSIONS=1024

# Texts sent in one embeddings request, 1 to 2048.
# Default: 64
#AUTOXIDE_EMBEDDING_BATCH_SIZE=64

# Send `dimensions` with each request so the model shortens its vectors (OpenAI
# `text-embedding-3-*` accepts it): `true` or `false`.
# Default: false
#AUTOXIDE_EMBEDDING_SEND_DIMENSIONS=false

# Directory where uploaded files are stored when AUTOXIDE_FILES_S3_BUCKET is
# unset; created when missing. Back it up together with the database.
# Default: data/files
#AUTOXIDE_FILES_DIR=data/files

# Store files in this S3 bucket (or a bucket of an S3-compatible service, with
# AWS_ENDPOINT_URL) instead of AUTOXIDE_FILES_DIR. The bucket must exist.
# Optional.
#AUTOXIDE_FILES_S3_BUCKET=my-app-files

# Folder inside the bucket under which files are stored, so one bucket can serve
# several deployments. Empty: the root of the bucket.
# Optional.
#AUTOXIDE_FILES_S3_PREFIX=production

# Region of the S3 bucket. S3-compatible services usually accept any value.
# Default: us-east-1
#AWS_REGION=us-east-1

# Address of an S3-compatible service (Cloudflare R2, Backblaze B2, Garage,
# SeaweedFS…). Unset: Amazon S3.
# Optional.
#AWS_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com

# Access key for the S3 bucket. Unset on AWS: the server's IAM role is used.
# Optional.
#AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE

# Secret of AWS_ACCESS_KEY_ID.
# Optional.
#AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Largest file that can be uploaded, in bytes (1 to 5368709120). Larger uploads
# are answered with 413. Big files also need enough time: raise
# AUTOXIDE_HTTP_REQUEST_TIMEOUT_SECONDS for slow clients.
# Default: 26214400
#AUTOXIDE_FILES_MAX_BYTES=26214400

# Media types that may be uploaded, comma-separated; `image/*` allows every
# image type. Unset: every type. Other types are answered with 415.
# Optional.
#AUTOXIDE_FILES_ALLOWED_TYPES=image/*,application/pdf,text/plain

# Secret key that signs access tokens: at least 32 characters, random. Generate
# one with `openssl rand -base64 48`. Every server of one deployment must use
# the same value. When unset, a random key is generated at startup: access
# tokens then stop working after a restart (clients refresh them), and several
# servers cannot share them.
# Optional.
#AUTOXIDE_AUTH_TOKEN_SECRET=change-me-to-a-long-random-value-from-openssl-rand

# How long an access token stays valid, in seconds (60 to 86400). Short is
# safer: a stolen token works only until it expires.
# Default: 900
#AUTOXIDE_AUTH_ACCESS_TOKEN_SECONDS=900

# How long a refresh token stays valid, in days (1 to 365). Each refresh issues
# a new one with a fresh lifetime; a session left unused this long must sign in
# again.
# Default: 30
#AUTOXIDE_AUTH_REFRESH_TOKEN_DAYS=30

# Failed sign-ins allowed for one email within AUTOXIDE_AUTH_LOGIN_LOCK_MINUTES
# (1 to 100). One more locks sign-in for that email for
# AUTOXIDE_AUTH_LOGIN_LOCK_MINUTES, even with the right password. Shared by
# every server, since it is counted in the database.
# Default: 5
#AUTOXIDE_AUTH_LOGIN_MAX_FAILURES=5

# How long failed sign-ins are remembered, and how long sign-in stays locked
# after too many (1 to 1440).
# Default: 15
#AUTOXIDE_AUTH_LOGIN_LOCK_MINUTES=15

# Let anyone create an account with `POST /api/v1/auth/register` (`true` or
# `false`). New accounts get no role. When `false`, only users with the
# `auth.users.manage` permission create accounts.
# Default: false
#AUTOXIDE_AUTH_SELF_REGISTRATION=false

# Name shown next to the account in authenticator apps (Google Authenticator,
# 1Password…) when a user turns on two-step sign-in. Usually your product name;
# no `:`.
# Default: Autoxide
#AUTOXIDE_AUTH_TOTP_ISSUER=Autoxide

# Page of your app where people choose a new password, with `{token}` where the
# reset token goes. Password-reset mail links there. When unset, the mail
# contains the token and says to call `POST
# /api/v1/auth/password-reset/confirm`.
# Optional.
#AUTOXIDE_AUTH_PASSWORD_RESET_URL=https://app.example.com/reset-password?token={token}

# Page of your app that confirms an email address, with `{token}` where the
# verification token goes. Verification mail links there. When unset, the mail
# contains the token and says to call `POST
# /api/v1/auth/email-verification/confirm`.
# Optional.
#AUTOXIDE_AUTH_EMAIL_VERIFICATION_URL=https://app.example.com/verify-email?token={token}

# Page of your app where the owner of an account reports an email change they
# did not make, with `{token}` where the report token goes. The mail sent to the
# old address after an email change links there. When unset, the mail contains
# the token and says to call `POST /api/v1/auth/email-change/report`.
# Optional.
#AUTOXIDE_AUTH_EMAIL_CHANGE_REPORT_URL=https://app.example.com/not-me?token={token}

# Request header in which your reverse proxy or CDN puts the caller's country
# (ISO 3166-1 two-letter code), e.g. `CF-IPCountry` behind Cloudflare. Each
# sign-in session keeps that code so people can spot a session they do not know;
# the IP address itself is never kept. Set it only when a proxy you trust always
# sets (or removes) this header. When unset, sessions have no country.
# Optional.
#AUTOXIDE_AUTH_COUNTRY_HEADER=CF-IPCountry

# Domain that passkeys belong to (the WebAuthn relying party id), usually your
# site's domain without scheme or port, e.g. `example.com`; passkeys then work
# on that domain and its subdomains. When unset, passkey sign-in is off.
# Changing it later makes every registered passkey unusable.
# Optional.
#AUTOXIDE_AUTH_PASSKEY_RP_ID=example.com

# Web origins allowed to use passkeys, comma-separated, e.g.
# `https://app.example.com,https://example.com`. Each must be on
# AUTOXIDE_AUTH_PASSKEY_RP_ID or a subdomain of it. Unset:
# `https://<AUTOXIDE_AUTH_PASSKEY_RP_ID>`.
# Optional.
#AUTOXIDE_AUTH_PASSKEY_ORIGINS=https://app.example.com

# Allow webhook addresses that start with `http://` (unencrypted). Only for
# development on one machine; in production every address must use `https://`.
# Default: false
#AUTOXIDE_WEBHOOKS_ALLOW_HTTP=false

# Allow webhook addresses in private or local networks (`localhost`, `10.x`,
# `192.168.x`, `169.254.x`, `fd00::/8`…). Off by default, so whoever creates a
# webhook cannot make the server call services that are reachable only from
# inside your network. Turn on only when the receivers run in your own network.
# Default: false
#AUTOXIDE_WEBHOOKS_ALLOW_PRIVATE_NETWORKS=false

# How long to wait for a webhook receiver to answer, in seconds (1 to 60). A
# slower answer counts as a failure and is retried.
# Default: 10
#AUTOXIDE_WEBHOOKS_TIMEOUT_SECONDS=10

# Largest media item that can be uploaded, in bytes (1 to 5368709120). Larger
# uploads are answered with 413. Big files also need enough time: raise
# AUTOXIDE_HTTP_REQUEST_TIMEOUT_SECONDS for slow clients.
# Default: 104857600
#AUTOXIDE_MEDIA_MAX_BYTES=104857600

# Media types that may be uploaded to the media library, comma-separated;
# `audio/*` allows every audio type. Other types are answered with 415. Whatever
# the list, the content must really be of the declared type.
# Default: image/jpeg,image/png,image/gif,image/webp,image/avif,image/svg+xml,video/mp4,video/webm,audio/*,application/pdf
#AUTOXIDE_MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,image/avif,image/svg+xml,video/mp4,video/webm,audio/*,application/pdf

# Days an item stays in the trash before it is deleted for good (1 to 3650).
# Default: 30
#AUTOXIDE_MEDIA_TRASH_DAYS=30

# Widths in pixels of the smaller copies made of every JPEG, PNG, GIF and WebP
# image (comma-separated, each 16 to 8192, at most 10); only widths smaller than
# the image are made. `off`: no smaller copies.
# Default: 320,640,1280,1920
#AUTOXIDE_MEDIA_IMAGE_WIDTHS=320,640,1280,1920

# Allow sending private images to the AI provider for alt text suggestions
# (`true` or `false`). Public images are already visible to anyone; private ones
# leave the server only when this is `true`.
# Default: false
#AUTOXIDE_MEDIA_AI_SEND_PRIVATE=false

# Languages a text alternative (`alt`) may be translated into, comma-separated
# BCP 47 codes (e.g. `en,vi,pt-BR`). The item's own `alt` stays the default for
# every other language.
# Default: en,vi
#AUTOXIDE_MEDIA_ALT_LOCALES=en,vi

# Languages content may be written in, comma-separated BCP 47 codes (e.g.
# `en,vi,pt-BR`).
# Default: en,vi
#AUTOXIDE_CONTENT_LOCALES=en,vi

# Language used when a request names none, and for category, tag and menu names
# missing in a language. Must be one of AUTOXIDE_CONTENT_LOCALES.
# Default: en
#AUTOXIDE_CONTENT_DEFAULT_LOCALE=en

# First segment of the address of every post: `blog` gives `/blog/<slug>`.
# Lower-case letters, digits and `-`.
# Default: blog
#AUTOXIDE_CONTENT_POST_PATH_PREFIX=blog

# Revisions kept per post or page (10 to 1000); older ones are removed by a
# daily job, except those still used by the published version or a pending
# schedule.
# Default: 50
#AUTOXIDE_CONTENT_MAX_REVISIONS=50

# Largest body of a post or page, in bytes of JSON (1024 to 4194304).
# Default: 524288
#AUTOXIDE_CONTENT_MAX_BODY_BYTES=524288

# Reading speed used for `reading_time_minutes` (50 to 1000). The default, 238,
# is measured for English; there is no published figure for Vietnamese.
# Default: 238
#AUTOXIDE_CONTENT_WORDS_PER_MINUTE=238

# Hosts whose addresses may be embedded in a body (`embed` blocks),
# comma-separated. A host also allows its subdomains.
# Default: youtube.com,youtu.be,youtube-nocookie.com,vimeo.com
#AUTOXIDE_CONTENT_EMBED_HOSTS=youtube.com,youtu.be,youtube-nocookie.com,vimeo.com

# Key that signs draft preview links, at least 32 characters. Unset: previews
# are off.
# Optional.
#AUTOXIDE_CONTENT_PREVIEW_SECRET=a-long-random-string-of-at-least-32-characters

# How long a draft preview link works, in seconds (60 to 604800).
# Default: 600
#AUTOXIDE_CONTENT_PREVIEW_TTL_SECONDS=600

# AI translation sends a long entry in parts of about this many tokens each (500
# to 100000); smaller parts suit smaller models.
# Default: 8000
#AUTOXIDE_CONTENT_TRANSLATE_BATCH_TOKENS=8000

# Serve search by meaning to anonymous readers at
# `/api/v1/content/public/search` (`true` or `false`). Every search costs one
# embeddings request, so it is off by default.
# Default: false
#AUTOXIDE_CONTENT_PUBLIC_SEMANTIC_SEARCH=false

# Public searches by meaning per minute (1 to 10000), one budget shared by every
# reader and counted per server process; past it, public searches match words
# only until the next minute. It bounds the embeddings cost; the general rate
# limit per address still applies.
# Default: 30
#AUTOXIDE_CONTENT_PUBLIC_SEARCH_PER_MINUTE=30

# Largest request body of a public form submission, in bytes (1024 to 1048576).
# Default: 65536
#AUTOXIDE_FORMS_MAX_SUBMISSION_BYTES=65536

# Most fields one form may have (1 to 200).
# Default: 50
#AUTOXIDE_FORMS_MAX_FIELDS=50

# Public submissions accepted per form from one network block (IPv4 /24, IPv6
# /64) per hour (1 to 100000); more are dropped silently. A form may set its own
# limit.
# Default: 10
#AUTOXIDE_FORMS_SUBMISSIONS_PER_IP_PER_HOUR=10

# Public submissions accepted per form from one email address per hour (1 to
# 100000); more are dropped silently. A form may set its own limit.
# Default: 5
#AUTOXIDE_FORMS_SUBMISSIONS_PER_EMAIL_PER_HOUR=5

# Submissions per hour from one caller with the permission `forms.submit`, e.g.
# a website server sending forms with its API key for all its visitors (1 to
# 1000000); more are refused with 429.
# Default: 1000
#AUTOXIDE_FORMS_SUBMISSIONS_PER_USER_PER_HOUR=1000

# Days a submission is kept before a daily job deletes it (0 to 36500; 0 keeps
# them until deleted by hand). A form may set its own. Check what the law that
# applies to you asks.
# Default: 0
#AUTOXIDE_FORMS_RETENTION_DAYS=0

# Days a submission marked as spam is kept before the daily job deletes it (1 to
# 3650).
# Default: 30
#AUTOXIDE_FORMS_SPAM_RETENTION_DAYS=30

# Days the hashed network address of a submission is kept before the daily job
# clears it (1 to 3650). Raw addresses are never stored.
# Default: 90
#AUTOXIDE_FORMS_IP_RETENTION_DAYS=90

# Language of the mail sent to a form's notify addresses: `en` or `vi`.
# Default: en
#AUTOXIDE_FORMS_NOTIFY_LANGUAGE=en

# Minutes a download link of a CSV export made in the background works (1 to
# 10080). The link needs no sign-in, so keep it short.
# Default: 60
#AUTOXIDE_FORMS_EXPORT_LINK_MINUTES=60

# Hours the file of a CSV export made in the background is kept before the daily
# job deletes it (1 to 720). The file holds personal data.
# Default: 24
#AUTOXIDE_FORMS_EXPORT_KEEP_HOURS=24

# Page of your website that confirms a newsletter subscription, with `{token}`
# where the token goes; the page sends it to `POST
# /api/v1/newsletter/public/confirm`. Needed to subscribe to a list with double
# opt-in; without it, sign-ups that must be confirmed on other lists (held by
# the anti-spam checks, or from people who unsubscribed) get no mail.
# Optional.
#AUTOXIDE_NEWSLETTER_CONFIRM_URL=https://www.example.com/newsletter/confirm?token={token}

# Page of your website where a subscriber chooses lists or unsubscribes, with
# `{token}` where the token goes; the page uses
# `/api/v1/newsletter/public/preferences`. Every campaign mail links there, so
# sending needs it.
# Optional.
#AUTOXIDE_NEWSLETTER_PREFERENCES_URL=https://www.example.com/newsletter/preferences?token={token}

# Address of your website, without a trailing slash, put in front of the path of
# a new post in new-post campaigns. When unset, new-post campaigns are only
# created as drafts.
# Optional.
#AUTOXIDE_NEWSLETTER_SITE_URL=https://www.example.com

# Hours a confirmation link stays valid (1 to 720).
# Default: 168
#AUTOXIDE_NEWSLETTER_CONFIRM_HOURS=168

# Sign-up requests per address per day that may send a confirmation mail (1 to
# 100); every request for the address counts, and later ones are answered as
# usual but send nothing.
# Default: 3
#AUTOXIDE_NEWSLETTER_CONFIRM_MAILS_PER_DAY=3

# Days an unconfirmed subscription is kept before a daily job deletes it (1 to
# 365).
# Default: 30
#AUTOXIDE_NEWSLETTER_UNCONFIRMED_DAYS=30

# Public subscribe requests accepted from one network block (IPv4 /24, IPv6 /64)
# per hour (1 to 100000); more are dropped silently.
# Default: 10
#AUTOXIDE_NEWSLETTER_SUBSCRIBE_PER_IP_PER_HOUR=10

# Public subscribe requests accepted for one email address per hour (1 to
# 100000); more are dropped silently.
# Default: 5
#AUTOXIDE_NEWSLETTER_SUBSCRIBE_PER_EMAIL_PER_HOUR=5

# Subscribe requests per hour from one caller with the permission
# `newsletter.subscribe`, e.g. a website server with an API key subscribing its
# visitors (1 to 1000000); more are refused with 429.
# Default: 1000
#AUTOXIDE_NEWSLETTER_SUBSCRIBE_PER_USER_PER_HOUR=1000

# Campaign mails handed to the mail queue per minute at most (1 to 100000). Keep
# it under what your mail relay accepts.
# Default: 300
#AUTOXIDE_NEWSLETTER_SEND_RATE_PER_MINUTE=300

# Campaign mails per sending job (1 to 1000); the jobs are spaced to keep the
# send rate.
# Default: 100
#AUTOXIDE_NEWSLETTER_BATCH_SIZE=100

# Soft bounces of one address before it is suppressed (1 to 100). A hard bounce
# or a complaint suppresses at once.
# Default: 3
#AUTOXIDE_NEWSLETTER_SOFT_BOUNCE_LIMIT=3

# Label put at the start of the subject of advertising campaigns (at most 20
# characters; `none` for no label). The default follows a reading of Vietnam's
# Decree 91/2020 that was not checked against the original text: check the law
# that applies to you.
# Default: [QC]
#AUTOXIDE_NEWSLETTER_ADVERTISING_LABEL=[QC]

# Advertising campaign mails one address may receive in 24 hours (0 to 100; 0:
# no limit); beyond it the mail is skipped. The default follows a reading of
# Vietnam's Decree 91/2020 that was not checked against the original text.
# Default: 3
#AUTOXIDE_NEWSLETTER_ADVERTISING_MAX_PER_DAY=3

# Name and postal address of the sender, put at the foot of every campaign mail
# (at most 300 characters). Needed to send advertising campaigns.
# Optional.
#AUTOXIDE_NEWSLETTER_POSTAL_ADDRESS=Example Ltd, 1 Example Street, Hanoi, Vietnam

# Whether new comments are taken at all (`true` or `false`). With `false`
# existing comments can still be read and moderated.
# Default: true
#AUTOXIDE_COMMENTS_ENABLED=true

# Comma-separated kinds of things that take comments, written `<module>.<kind>`.
# A kind another module resolves (e.g. `content.entry`) must exist and be
# public; any other kind is taken as given.
# Default: content.entry
#AUTOXIDE_COMMENTS_TARGET_TYPES=content.entry

# Whether people without an account may comment (`true` or `false`). Some laws
# (e.g. a reading of Vietnam's Decree 147/2024 for social networks) may require
# signed-in, verified accounts: check what applies to you.
# Default: true
#AUTOXIDE_COMMENTS_ALLOW_GUESTS=true

# Comma-separated target kinds where only signed-in users may comment, even when
# guests are allowed elsewhere.
# Optional.
#AUTOXIDE_COMMENTS_SIGNED_IN_ONLY_TYPES=media.item

# Comma-separated target kinds where only verified accounts may comment or
# answer (e.g. product questions, Vietnam's Decree 147/2024): guests are
# refused, and signed-in users are checked with the module that keeps account
# verification. With no such module installed, every signed-in account counts as
# verified.
# Optional.
#AUTOXIDE_COMMENTS_VERIFIED_ONLY_TYPES=catalog.product

# When a guest's comment needs approval: `pre` (always), `first_time` (guests
# have no account to remember, so this works like `pre`) or `post` (shown at
# once).
# Default: pre
#AUTOXIDE_COMMENTS_GUEST_MODERATION=pre

# When a signed-in user's comment needs approval: `pre` (always), `first_time`
# (until one of their comments was approved) or `post` (shown at once).
# Default: first_time
#AUTOXIDE_COMMENTS_USER_MODERATION=first_time

# Comma-separated overrides per target kind, written `<kind>:guest=<mode>` or
# `<kind>:user=<mode>` with the modes above.
# Optional.
#AUTOXIDE_COMMENTS_MODERATION_BY_TYPE=content.entry:guest=pre,content.entry:user=post

# Longest comment, in characters (10 to 20000).
# Default: 4000
#AUTOXIDE_COMMENTS_MAX_LENGTH=4000

# A comment with more links than this is held for approval (0 to 100).
# Default: 2
#AUTOXIDE_COMMENTS_MAX_LINKS=2

# Whether comments may be written in Markdown (`true` or `false`): bold,
# italics, links, quotes and code, rendered to safe HTML. Plain text works
# either way.
# Default: true
#AUTOXIDE_COMMENTS_MARKDOWN=true

# Minutes during which authors may change their comment (0 to 1440; 0: never).
# Deleting their own comment is always allowed.
# Default: 15
#AUTOXIDE_COMMENTS_EDIT_MINUTES=15

# Reports that hold a shown comment for approval again (1 to 1000). This happens
# once per comment: after a moderator approves it, more reports do not hide it.
# Default: 3
#AUTOXIDE_COMMENTS_REPORT_THRESHOLD=3

# Days after its first comment a target stops taking comments (0 to 36500; 0:
# never).
# Default: 0
#AUTOXIDE_COMMENTS_AUTO_CLOSE_DAYS=0

# Comma-separated words or phrases that make a comment refused (whole words,
# ignoring case and accents).
# Optional.
#AUTOXIDE_COMMENTS_BANNED_WORDS=casino,viagra

# Comma-separated words or phrases that hold a comment for approval (whole
# words, ignoring case and accents).
# Optional.
#AUTOXIDE_COMMENTS_SUSPECT_WORDS=giảm giá,free money

# Comma-separated names guests and users may not show as theirs (ignoring case
# and accents); moderators may.
# Default: admin,administrator,moderator,root,system
#AUTOXIDE_COMMENTS_RESERVED_NAMES=admin,administrator,moderator,root,system

# Guest comments accepted per target kind from one network block (IPv4 /24, IPv6
# /64) per hour (1 to 100000); more are dropped silently.
# Default: 20
#AUTOXIDE_COMMENTS_PER_IP_PER_HOUR=20

# Guest comments accepted per target kind from one email address per hour (1 to
# 100000); more are dropped silently.
# Default: 10
#AUTOXIDE_COMMENTS_PER_EMAIL_PER_HOUR=10

# Comments per hour from one signed-in user (1 to 1000000); more are refused
# with 429.
# Default: 60
#AUTOXIDE_COMMENTS_PER_USER_PER_HOUR=60

# Reports counted per hour from one network block or user (1 to 100000); more
# are answered as usual but not stored.
# Default: 30
#AUTOXIDE_COMMENTS_REPORTS_PER_HOUR=30

# Days a comment that was never shown (waiting for approval or marked as spam)
# is kept before a daily job deletes it (1 to 3650). Comments that were shown
# once are never deleted on their own: a moderator decides.
# Default: 30
#AUTOXIDE_COMMENTS_RETENTION_DAYS=30

# Days the hashed network address of a comment (and of a guest's report) is kept
# before the daily job clears it (1 to 3650). Raw addresses are never stored.
# Default: 90
#AUTOXIDE_COMMENTS_IP_RETENTION_DAYS=90

# Page of your website that confirms an email address for reply mails, with
# `{token}` where the token goes; the page sends it to `POST
# /api/v1/comments/public/verify`. Without it (or the unsubscribe page) reply
# mails are off.
# Optional.
#AUTOXIDE_COMMENTS_VERIFY_URL=https://www.example.com/comments/verify?token={token}

# Page of your website that stops reply mails, with `{token}` where the token
# goes; the page sends it to `POST /api/v1/comments/public/unsubscribe`. Every
# reply mail links there.
# Optional.
#AUTOXIDE_COMMENTS_UNSUBSCRIBE_URL=https://www.example.com/comments/unsubscribe?token={token}

# Address of your website, put before the path of the commented page in reply
# mails.
# Optional.
#AUTOXIDE_COMMENTS_SITE_URL=https://www.example.com

# Address confirmation mails sent to one address in 24 hours (1 to 100).
# Default: 3
#AUTOXIDE_COMMENTS_VERIFY_MAILS_PER_DAY=3

# Languages a website menu may be written in, comma-separated BCP 47 codes (e.g.
# `en,vi`).
# Default: en,vi
#AUTOXIDE_MENUS_LOCALES=en,vi

# Language of the menu served when a menu is missing in the language asked for.
# Must be one of AUTOXIDE_MENUS_LOCALES.
# Default: en
#AUTOXIDE_MENUS_DEFAULT_LOCALE=en

# How long a public menu is kept ready in memory and may be cached by browsers,
# in seconds (0 to 3600; 0 turns caching off). A renamed or moved target shows
# within this time.
# Default: 60
#AUTOXIDE_MENUS_PUBLIC_CACHE_SECONDS=60
