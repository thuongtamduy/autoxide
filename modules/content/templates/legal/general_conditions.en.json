{
 "key": "general_conditions",
 "locale": "en",
 "title": "General conditions of trading",
 "marketplace": false,
 "needs_legal_review": true,
 "variables": [
  {
   "path": "owner.legal_name",
   "required": true,
   "description": "Registered name of the owner (legal profile)."
  },
  {
   "path": "website.domain",
   "required": false,
   "description": "Domain of the website, e.g. shop.example."
  },
  {
   "path": "owner.address",
   "required": false,
   "description": "Address of the owner, on one line."
  },
  {
   "path": "contact.email",
   "required": false,
   "description": "Contact email."
  },
  {
   "path": "contact.phone",
   "required": false,
   "description": "Contact phone number."
  }
 ],
 "body": {
  "type": "doc",
  "content": [
   {
    "type": "blockquote",
    "content": [
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "Sample content — have a legal professional review it before use. It is not legal advice; check it against the laws in force.",
        "marks": [
         {
          "type": "bold"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "These general conditions apply to every purchase on {{ website.domain or \"this website\" }} from {{ owner.legal_name }}, {{ owner.address or \"[address]\" }}."
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Orders"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "An order is confirmed when we send the confirmation. Prices include the taxes shown at checkout."
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Delivery, payment, returns"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "See the shipping, payment, inspection and return policies on this website; they are part of these conditions."
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Warranty and complaints"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "Warranty terms are shown on each product. Complaints follow our complaint handling policy."
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Contact"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "{{ contact.phone or \"[phone]\" }} — {{ contact.email or \"[email]\" }}"
     }
    ]
   }
  ]
 }
}
