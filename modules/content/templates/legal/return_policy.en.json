{
 "key": "return_policy",
 "locale": "en",
 "title": "Return and refund policy",
 "marketplace": false,
 "needs_legal_review": true,
 "variables": [
  {
   "path": "owner.legal_name",
   "required": true,
   "description": "Registered name of the owner (legal profile)."
  },
  {
   "path": "policy.return_days",
   "required": true,
   "description": "Days a buyer has to ask for a return."
  },
  {
   "path": "contact.phone",
   "required": true,
   "description": "Contact phone number."
  },
  {
   "path": "contact.email",
   "required": false,
   "description": "Contact email."
  }
 ],
 "body": {
  "type": "doc",
  "content": [
   {
    "type": "blockquote",
    "content": [
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "Sample content — have a legal professional review it before use. It is not legal advice; check it against the laws in force.",
        "marks": [
         {
          "type": "bold"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "When you can return"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "You may ask to return or exchange goods within {{ policy.return_days }} days of receiving them when the goods are faulty, damaged in transport, or not as described."
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Conditions"
     }
    ]
   },
   {
    "type": "bulletList",
    "content": [
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Goods keep their packaging, labels and accessories, unless the fault is ours."
         }
        ]
       }
      ]
     },
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Keep the invoice or order number."
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "How to ask"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "Call {{ contact.phone }} or write to {{ contact.email or \"[email]\" }} with your order number and photos of the goods."
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Refunds"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "{{ owner.legal_name }} refunds by the original payment method once the returned goods are checked. Return shipping is free when the fault is ours."
     }
    ]
   }
  ]
 }
}
