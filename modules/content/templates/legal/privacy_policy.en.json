{
 "key": "privacy_policy",
 "locale": "en",
 "title": "Personal data protection policy",
 "marketplace": false,
 "needs_legal_review": true,
 "variables": [
  {
   "path": "owner.legal_name",
   "required": true,
   "description": "Registered name of the owner (legal profile)."
  },
  {
   "path": "contact.email",
   "required": true,
   "description": "Contact email."
  },
  {
   "path": "owner.address",
   "required": false,
   "description": "Address of the owner, on one line."
  },
  {
   "path": "website.domain",
   "required": false,
   "description": "Domain of the website, e.g. shop.example."
  }
 ],
 "body": {
  "type": "doc",
  "content": [
   {
    "type": "blockquote",
    "content": [
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "Sample content — have a legal professional review it before use. It is not legal advice; check it against the laws in force.",
        "marks": [
         {
          "type": "bold"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "{{ owner.legal_name }} (\"we\") processes personal data of the people who use {{ website.domain or \"our website\" }} as this policy explains."
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Data we collect"
     }
    ]
   },
   {
    "type": "bulletList",
    "content": [
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Account and contact data you give: name, email, phone number, delivery address."
         }
        ]
       }
      ]
     },
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Order and payment data needed to deliver what you buy (we do not store full card numbers)."
         }
        ]
       }
      ]
     },
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Technical data: device, pages viewed — only with your consent when it is not strictly necessary."
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Why we use it"
     }
    ]
   },
   {
    "type": "bulletList",
    "content": [
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "To provide the service and deliver orders (contract)."
         }
        ]
       }
      ]
     },
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "To meet legal duties, e.g. invoices and records (legal obligation)."
         }
        ]
       }
      ]
     },
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "To send news and offers — only with your consent, which you can withdraw at any time."
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Your rights"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "You may ask to see, correct or delete your data, withdraw consent, or object to processing. Write to {{ contact.email }}."
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Keeping and protecting data"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "We keep data only as long as needed for these purposes or as the law requires, and protect it with technical and organizational measures. A data breach is handled within the time the law sets."
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Contact"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "{{ owner.legal_name }}, {{ owner.address or \"[address]\" }} — {{ contact.email }}."
     }
    ]
   }
  ]
 }
}
