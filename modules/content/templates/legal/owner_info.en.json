{
 "key": "owner_info",
 "locale": "en",
 "title": "Website owner",
 "marketplace": false,
 "needs_legal_review": true,
 "variables": [
  {
   "path": "owner.legal_name",
   "required": true,
   "description": "Registered name of the owner (legal profile)."
  },
  {
   "path": "owner.address",
   "required": true,
   "description": "Address of the owner, on one line."
  },
  {
   "path": "contact.email",
   "required": true,
   "description": "Contact email."
  },
  {
   "path": "contact.phone",
   "required": true,
   "description": "Contact phone number."
  },
  {
   "path": "owner.trade_name",
   "required": false,
   "description": "Trade name of the owner."
  },
  {
   "path": "owner.tax_code",
   "required": false,
   "description": "Tax code of the owner."
  },
  {
   "path": "owner.registration_number",
   "required": false,
   "description": "Business registration number."
  },
  {
   "path": "owner.registration_issued_on",
   "required": false,
   "description": "Date the registration was issued."
  },
  {
   "path": "owner.registration_issued_by",
   "required": false,
   "description": "Who issued the registration."
  },
  {
   "path": "owner.representative_name",
   "required": false,
   "description": "Legal representative."
  },
  {
   "path": "website.domain",
   "required": false,
   "description": "Domain of the website, e.g. shop.example."
  }
 ],
 "body": {
  "type": "doc",
  "content": [
   {
    "type": "blockquote",
    "content": [
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "Sample content — have a legal professional review it before use. It is not legal advice; check it against the laws in force.",
        "marks": [
         {
          "type": "bold"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Owner"
     }
    ]
   },
   {
    "type": "bulletList",
    "content": [
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Name: {{ owner.legal_name }}"
         }
        ]
       }
      ]
     },
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Trade name: {{ owner.trade_name or owner.legal_name }}"
         }
        ]
       }
      ]
     },
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Tax code: {{ owner.tax_code or \"[tax code]\" }}"
         }
        ]
       }
      ]
     },
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Business registration: {{ owner.registration_number or \"[number]\" }}, issued on {{ owner.registration_issued_on or \"[date]\" }} by {{ owner.registration_issued_by or \"[issuer]\" }}"
         }
        ]
       }
      ]
     },
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Address: {{ owner.address }}"
         }
        ]
       }
      ]
     },
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Legal representative: {{ owner.representative_name or \"[name]\" }}"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Contact"
     }
    ]
   },
   {
    "type": "bulletList",
    "content": [
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Phone: {{ contact.phone }}"
         }
        ]
       }
      ]
     },
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Email: {{ contact.email }}"
         }
        ]
       }
      ]
     },
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Website: {{ website.domain or \"[domain]\" }}"
         }
        ]
       }
      ]
     }
    ]
   }
  ]
 }
}
