{
 "key": "complaint_policy",
 "locale": "en",
 "title": "Complaint handling",
 "marketplace": false,
 "needs_legal_review": true,
 "variables": [
  {
   "path": "owner.legal_name",
   "required": true,
   "description": "Registered name of the owner (legal profile)."
  },
  {
   "path": "contact.email",
   "required": true,
   "description": "Contact email."
  },
  {
   "path": "contact.phone",
   "required": true,
   "description": "Contact phone number."
  },
  {
   "path": "policy.complaint_days",
   "required": true,
   "description": "Working days to answer a complaint."
  },
  {
   "path": "owner.address",
   "required": false,
   "description": "Address of the owner, on one line."
  }
 ],
 "body": {
  "type": "doc",
  "content": [
   {
    "type": "blockquote",
    "content": [
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "Sample content — have a legal professional review it before use. It is not legal advice; check it against the laws in force.",
        "marks": [
         {
          "type": "bold"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Where to complain"
     }
    ]
   },
   {
    "type": "bulletList",
    "content": [
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Phone: {{ contact.phone }}"
         }
        ]
       }
      ]
     },
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Email: {{ contact.email }}"
         }
        ]
       }
      ]
     },
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Address: {{ owner.address or \"[address]\" }}"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "heading",
    "attrs": {
     "level": 2
    },
    "content": [
     {
      "type": "text",
      "text": "Steps"
     }
    ]
   },
   {
    "type": "bulletList",
    "content": [
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "We confirm we received your complaint."
         }
        ]
       }
      ]
     },
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "We answer within {{ policy.complaint_days }} working days, with the result and what we will do."
         }
        ]
       }
      ]
     },
     {
      "type": "listItem",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "If you do not agree, the parties negotiate; otherwise you may turn to a consumer protection organization, mediation, arbitration or the court, as the law allows."
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "paragraph",
    "content": [
     {
      "type": "text",
      "text": "{{ owner.legal_name }} does not remove or hide fair reviews and complaints."
     }
    ]
   }
  ]
 }
}
